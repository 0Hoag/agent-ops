HTTP_ADDR=:8080
# Host-run API; Compose publishes POSTGRES_HOST_PORT (default 5432) on localhost.
DATABASE_URL=postgres://agent_ops:agent_ops_dev@localhost:${POSTGRES_HOST_PORT:-5432}/agent_ops?sslmode=disable
LOG_LEVEL=info
SCM_REPOSITORIES_JSON=[{"provider":"github","full_name":"0Hoag/agent-ops","webhook_secret_env":"WEBHOOK_SECRET","token_env":"GITHUB_TOKEN","base_url_env":"GITHUB_API_BASE_URL"},{"provider":"gitlab","full_name":"group/project","webhook_secret_env":"GITLAB_WEBHOOK_SECRET","token_env":"GITLAB_TOKEN","base_url_env":"GITLAB_API_BASE_URL"}]
WEBHOOK_SECRET=
GITHUB_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com
GITLAB_WEBHOOK_SECRET=
GITLAB_TOKEN=
GITLAB_API_BASE_URL=https://gitlab.com
AGENT_RUN_TOKEN=
# Prices are USD per million tokens: {"model":{"input_per_million":...}}
AGENT_RUN_MODEL_PRICES={}
