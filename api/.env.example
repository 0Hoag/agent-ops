HTTP_ADDR=:8080
# Host-run API; Compose publishes POSTGRES_HOST_PORT (default 5432) on localhost.
DATABASE_URL=postgres://agent_ops:agent_ops_dev@localhost:${POSTGRES_HOST_PORT:-5432}/agent_ops?sslmode=disable
LOG_LEVEL=info
SCM_REPOSITORIES_JSON=[{"provider":"github","full_name":"0Hoag/agent-ops","webhook_secret_env":"WEBHOOK_SECRET","token_env":"GITHUB_TOKEN","base_url_env":"GITHUB_API_BASE_URL"}]
WEBHOOK_SECRET=
GITHUB_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com
