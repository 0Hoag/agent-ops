                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/response.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/repositories": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "summary": "List repositories",
                "parameters": [
                    {
                        "type": "integer",
