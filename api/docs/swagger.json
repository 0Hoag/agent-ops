                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/response.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/board/ws": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "summary": "Board invalidation websocket handshake",
                "parameters": [
                    {
                        "type": "string",
                        "format": "uuid",
                        "description": "Repository UUID",
                        "name": "repository_id",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "101": {
                        "description": "Switching Protocols",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/response.ErrorResponse"
                        }
                    }
                }
            }
        },
