                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/agentrun.Aggregate"
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/board": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "summary": "List board issues",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Repository UUID",
                        "name": "repository_id",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "description": "Page",
                        "name": "page",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "Items per page",
                        "name": "per_page",
