{
    "swagger": "2.0",
    "info": {
        "description": "API for repository synchronization and signed webhooks.",
        "title": "Agent Ops API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/",
    "paths": {
        "/api/v1/agent-runs": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "summary": "List agent runs",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Repository UUID",
                        "name": "repository_id",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Wave",
                        "name": "wave",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "Issue number",
                        "name": "issue_number",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/agentrun.AgentRun"
                            }
                        }
                    }
                }
            },
            "post": {
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "summary": "Create an agent run",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Static agent run token",
                        "name": "X-Agent-Run-Token",
                        "in": "header",
                        "required": true
                    },
                    {
                        "description": "Agent run",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/agentrun.CreateInput"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/agentrun.AgentRun"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/response.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/response.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/agent-runs/aggregate": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "summary": "Aggregate agent runs",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Repository UUID",
                        "name": "repository_id",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Wave",
