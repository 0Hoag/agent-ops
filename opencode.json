{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-6.1-sol",
  "skills": {
    "paths": [
      "~/.codex/skills/orchestrator-workers"
    ]
  },
  "permission": {
    "edit": "allow",
    "webfetch": "allow",
    "doom_loop": "allow",
    "bash": {
      "*": "allow",
      "sudo *": "deny",
      "rm -rf /*": "deny",
      "rm -rf ~*": "deny",
      "git push --force*": "deny",
      "git reset --hard*": "deny"
    },
    "external_directory": {
      "*": "allow",
      "~/agent-ops-wt/**": "allow",
      "~/.codex/skills/**": "allow",
      "~/.ssh/**": "deny",
      "~/.config/gh/**": "deny",
      "~/.codex/worker.config.toml": "allow",
      "/private/tmp/**": "allow",
      "/tmp/**": "allow",
      "~/Library/Caches/pnpm/**": "allow",
      "~/Library/pnpm/**": "allow",
      "~/go/pkg/mod/**": "allow",
      "~/Library/Caches/go-build/**": "allow",
      "~/Library/Caches/golangci-lint/**": "allow",
      "~/.codex/auth.json": "deny",
      "~/.local/share/opencode/auth.json": "deny"
    }
  }
}