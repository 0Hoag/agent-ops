{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-6.1-sol",
  "skills": {
    "paths": ["~/.codex/skills/orchestrator-workers"]
  },
  "permission": {
    "edit": "allow",
    "webfetch": "allow",
    "bash": {
      "*": "allow",
      "sudo *": "deny",
      "rm -rf /*": "deny",
      "rm -rf ~*": "deny",
      "git push --force*": "deny",
      "git reset --hard*": "deny"
    },
    "external_directory": {
      "*": "ask",
      "~/agent-ops-wt/**": "allow",
      "~/.codex/skills/**": "allow",
      "~/.codex/worker.config.toml": "allow",
      "~/.codex/auth.json": "deny",
      "~/.local/share/opencode/auth.json": "deny",
      "/private/tmp/**": "allow",
      "/tmp/**": "allow"
    }
  }
}
